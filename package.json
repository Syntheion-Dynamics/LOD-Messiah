{
  "name": "lod-messiah",
  "version": "1.0.0",
  "description": "LOD Messiah — KitBash / high-poly → engine-ready GLB LOD pipeline",
  "type": "module",
  "bin": {
    "hp-convert": "./src/cli.js",
    "lod-messiah": "./src/cli.js"
  },
  "scripts": {
    "convert": "node src/cli.js",
    "convert:kits": "node src/cli.js --kits-root \"./Kitbash Assets\" --no-ktx2 --max-texture 2048 --impostor-res 4096 --impostor-frames 16 --lod3-silhouette --lod3-res 2048 --lod3-slices 8 --lod3-method visual-hull --jobs 7",
    "convert:engine": "node src/cli.js --kits-root \"./Kitbash Assets\" --no-ktx2 --max-texture 2048 --impostor-res 4096 --impostor-frames 16 --lod3-silhouette --lod3-res 2048 --lod3-slices 8 --lod3-method visual-hull --jobs 7",
    "rebake:impostors": "node scripts/rebake-kitbash-impostors.js",
    "rebake:lod3": "node scripts/rebake-lod3-kits.js",
    "ship": "node scripts/ship-to-engine.js",
    "smoke": "node src/cli.js --input ./input --output ./output --max-texture 2048 --ratio 0.5 --no-impostor --no-ktx2",
    "gallery": "node src/gallery-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntheion-Dynamics/LOD-Messiah.git"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.2.1",
    "@gltf-transform/extensions": "^4.2.1",
    "@gltf-transform/functions": "^4.2.1",
    "meshoptimizer": "^0.25.0",
    "puppeteer": "^24.0.0",
    "sharp": "^0.35.3",
    "three": "^0.175.0",
    "watlas": "^1.0.1"
  }
}
